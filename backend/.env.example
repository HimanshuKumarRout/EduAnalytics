# ─── Supabase PostgreSQL Connection ──────────────────────────────────────────
# Replace with your Supabase database connection string from:
# Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
#
# Option A (Connection Pooling - Port 6543, Recommended):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B (Direct Connection - Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# ─── Django Settings ─────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-student-performance-analysis-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
